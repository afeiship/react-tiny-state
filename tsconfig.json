{
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react",
    "target": "es5",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "pretty": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "moduleResolution": "node",
    "noImplicitAny": false
  },
  "include": ["src"]
}
